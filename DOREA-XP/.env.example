# .env.example - DOREA-XP 최소 환경변수 템플릿 (실사용 키만)
# 사용법: 이 파일을 복사해 `.env`로 만들고 값만 바꿔 사용

# ==============================
# 필수
# ==============================

# 관리자 초기 비밀번호 (없으면 backend 부팅 실패)
ADMIN_INITIAL_PASSWORD=dorea

# JWT 시크릿 (운영에서는 반드시 강한 랜덤값으로 변경)
# 주의: 이 키를 변경하면 저장된 MCP 시크릿이 전부 무효화된다.
JWT_SECRET_KEY=change-me-to-strong-random-secret

# ==============================
# 선택 (기본값 있음)
# ==============================

# 앱 메타
APP_NAME=DOREA-XP (공개용)
ENVIRONMENT=production

# SQLite / Chroma 경로 (docker-compose 기본값과 동일)
DB_PATH=/app/DATABASE/dorea.db
CHROMA_PATH=/app/DATABASE/chroma

# 처리 제한
MAX_FILE_SIZE=524288000
MAX_CONCURRENT_ANALYSIS=2

# 서비스 URL (docker-compose 기준)
OLLAMA_URL=http://ollama:11434
CONVERTER_URL=http://document-converter:8003
OPENDATALOADER_URL=http://opendataloader:8005
MCP_SERVICE_URL=http://dorea-xp-mcp-service:8002
FRONTEND_URL=http://localhost:8000

# ==============================
# KISTI-MCP demo 서버 키 (선택)
# ==============================
# 비워두면 KISTI-MCP 호출만 실패하고 그 외 기능은 정상 동작한다.
SCIENCEON_API_KEY=
NTIS_API_KEY=
DATAON_API_KEY=
